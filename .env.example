# ==========================================
# UpNext Backend - Environment Template
# ==========================================

# Server Configuration
PORT=5000
FRONTEND_ORIGIN="http://localhost:5173"

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=upnext_db

# Prisma Database Connection URL (Connect to 'db' container service in Docker Compose)
DATABASE_URL="postgresql://postgres:postgres_password@db:5432/upnext_db?schema=public"

# Authentication & Security Keys
JWT_SECRET="your_jwt_secret_key_example"
SUPERUSER_SECRET="your_superuser_secret_key_example"

# Cloudinary Configuration (Dummy values for demonstration)
CLOUD_NAME="your_cloud_name_example"
API_KEY="your_api_key_example"
API_SECRET="your_api_secret_example"
